# ---------------------------------------------------------------------------
# Telegram Auto Poster - configuration.
# Copy to .env (or run: python scripts/generate_keys.py --init-env) and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# "production" (default) or "development".
APP_ENV=production

# Public address of this installation, no trailing path. Must be https:// in production.
# The license is bound to this address.
APP_URL=https://poster.example.com

# Secret used to sign login cookies. At least 32 random characters.
# Generate: python scripts/generate_keys.py
APP_SECRET=

# Key that encrypts Telegram sessions in the database (Fernet key).
# Generate: python scripts/generate_keys.py
# BACK IT UP. If it is lost, connected Telegram accounts must be re-connected.
# For rotation put the new key first, then the old key, comma separated.
SESSION_ENCRYPTION_KEY=

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
# (Supabase/Neon/Railway strings work too). With docker-compose this is set
# automatically from POSTGRES_PASSWORD, so you can leave it empty there.
DATABASE_URL=

# Password for the PostgreSQL container started by docker-compose.
POSTGRES_PASSWORD=

# Your own Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Where uploaded post images are stored (must be a persistent disk/volume).
MEDIA_DIR=./data/media
# Maximum size of one uploaded image, in megabytes.
MAX_UPLOAD_MB=20

# Worker: how often (seconds) it looks for due posts.
WORKER_POLL_SECONDS=5
# Safety limits so the account is not flooded: minimum seconds between two
# sends from the same Telegram account, and maximum posts per hour per account.
POST_MIN_INTERVAL_SECONDS=5
MAX_POSTS_PER_HOUR=60

# First-run protection (recommended): if set, the "create admin" page asks for this
# value, so nobody else can claim a freshly deployed installation. Any random string.
SETUP_TOKEN=

# Dashboard login sessions: logged out after this many idle minutes / total hours.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=168

# Set to true ONLY when the app runs behind your own reverse proxy that sets
# X-Forwarded-For. Otherwise leave false (login rate limits use the real client IP).
TRUST_PROXY_HEADERS=false

# Apply database migrations automatically at start-up (recommended).
AUTO_MIGRATE=true

# Port published by docker-compose.
WEB_PORT=8000
