# ---------------------------------------------------------------------------
# Telegram Auto Poster - configuration.
# Copy to .env (or run: python scripts/generate_keys.py --init-env) and fill in.
# NEVER commit the real .env file.
# ---------------------------------------------------------------------------

# "production" (default) or "development".
APP_ENV=production

# Public address of this installation, no trailing path. Must be https:// in production.
# The license is bound to this address.
APP_URL=https://poster.example.com

# Secret used to sign login cookies. At least 32 random characters.
# Generate: python scripts/generate_keys.py
APP_SECRET=

# Secret that encrypts Telegram sessions in the database. Two forms are accepted:
#   1. a Fernet key (generate: python scripts/generate_keys.py), used as is; or
#   2. any other random secret of at least 32 characters, no spaces or commas (for example the value a hosting
#      platform such as Render generates for you). It is turned into a Fernet key with HKDF-SHA256; the same
#      secret always gives the same key, and neither the secret nor the derived key is stored anywhere.
# KEEP IT STABLE and BACK IT UP. Changing or losing it makes stored Telegram sessions unreadable
# (accounts must be re-connected). For rotation put the new value first, then the old one, comma separated.
SESSION_ENCRYPTION_KEY=

# PostgreSQL connection string, e.g. postgresql://user:password@host:5432/dbname
# (Supabase/Neon/Railway strings work too). With docker-compose this is set
# automatically from POSTGRES_PASSWORD, so you can leave it empty there.
DATABASE_URL=

# Password for the PostgreSQL container started by docker-compose.
POSTGRES_PASSWORD=

# Your own Telegram API credentials from https://my.telegram.org/apps
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Where uploaded post images are stored: 'database' (default, in PostgreSQL, works on hosts without a persistent disk)
# or 'local' (files in MEDIA_DIR, needs a persistent disk/volume).
MEDIA_STORAGE=database
# Only used when MEDIA_STORAGE=local.
MEDIA_DIR=./data/media
# Maximum size of one uploaded image, in megabytes.
MAX_UPLOAD_MB=20

# Worker: how often (seconds) it looks for due posts.
WORKER_POLL_SECONDS=5
# Safety limits so the account is not flooded: minimum seconds between two
# sends from the same Telegram account, and maximum posts per hour per account.
POST_MIN_INTERVAL_SECONDS=5
MAX_POSTS_PER_HOUR=60

# First-run protection (recommended): if set, the "create admin" page asks for this
# value, so nobody else can claim a freshly deployed installation. Any random string.
SETUP_TOKEN=

# Dashboard login sessions: logged out after this many idle minutes / total hours.
SESSION_IDLE_MINUTES=120
SESSION_MAX_HOURS=168

# Set to true ONLY when the app runs behind your own reverse proxy that sets
# X-Forwarded-For. Otherwise leave false (login rate limits use the real client IP).
TRUST_PROXY_HEADERS=false

# --- Development / testing ONLY (see docs/STEP3_REAL_TELEGRAM_VERIFICATION.md) -------------------
# Testing on a trusted local network needs: APP_ENV=development, APP_URL=http://<your-pc-ip>:8000 and the line
#   LICENSE_ENFORCEMENT=false
# These are refused in production mode. Never use plain http:// or disabled licensing on the internet.

# --- Temporary HTTPS test server only (deploy/cloud-init-https-test.sh sets these automatically) ---
#   WEB_BIND_ADDR=127.0.0.1      keep the plain-http port off the public internet (Caddy is the only entrance)
#   APP_HOST=<name>.sslip.io     the host name Caddy gets a certificate for (same host as APP_URL)

# --- Render (temporary test deployment, see render.yaml and docs/STEP3_REAL_TELEGRAM_VERIFICATION_RENDER.md) ---
# On Render APP_URL may stay empty: the platform's RENDER_EXTERNAL_URL (https) is used. An explicit APP_URL always wins.

# Apply database migrations automatically at start-up (recommended).
AUTO_MIGRATE=true

# Port published by docker-compose.
WEB_PORT=8000
